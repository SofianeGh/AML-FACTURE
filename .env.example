# Copier ce fichier en .env puis adapter (utilisé par docker compose).

# Premier compte administrateur, créé au démarrage si aucun compte n'existe.
# Changez le mot de passe après la première connexion, puis videz ces deux lignes.
ADMIN_UTILISATEUR=sofiane
ADMIN_MOT_DE_PASSE=changez-moi-tout-de-suite

# Nombre de reverse proxys devant l'application (nginx, Apache, Traefik…), 0 sinon.
# Indispensable derrière un proxy pour l'adresse IP des visiteurs, le HTTPS et un sous-dossier (/factures).
TRUST_PROXY=1

# Laisser à 1 en production (site en HTTPS). 0 seulement pour un essai en http.
COOKIE_SECURE=1

# Clé de signature des sessions. Facultative : sinon générée dans le volume de données.
# SECRET_KEY=

# Port d'écoute dans le conteneur et nombre de threads.
# PORT=8000
# THREADS=8
